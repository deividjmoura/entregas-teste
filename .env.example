# Banco (Neon)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Firebase (Authentication -> Google) 
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Portão de acesso — cada cliente recebe um código próprio
ACCESS_CODE="defina-um-codigo-por-cliente"
ACCESS_TOKEN="gere-uma-string-aleatoria-longa-por-cliente"

# Configuração do Servidor (Node.js / Next.js)
PUSHER_APP_ID="cole_o_app_id_aqui"
NEXT_PUBLIC_PUSHER_KEY="cole_a_key_aqui"
PUSHER_SECRET="cole_o_secret_aqui"
NEXT_PUBLIC_PUSHER_CLUSTER="sa1"

# Configuração do Servidor (Node.js / Next.js) para Push Notifications
# .env.local deve conter as chaves reais

NEXT_PUBLIC_VAPID_PUBLIC_KEY="cole_a_chave_publica_aqui"
VAPID_PRIVATE_KEY="cole_a_chave_publica_aqui"
VAPID_SUBJECT="cole_a_chave_publica_aqui"